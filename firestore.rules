rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Bloqueia por padrão todas as coleções não declaradas abaixo.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'dariocarlos517@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Campos alinhados com o modelo de dados utilizado pelo index.html.
    function isValidCard(data) {
      return data.nome is string
        && data.nome.size() > 0
        && data.nome.size() <= 100
        && data.slug is string
        && data.slug.size() > 0
        && data.slug.size() <= 128
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('profissao' in data) || (data.profissao is string && data.profissao.size() <= 100))
        && (!('empresa' in data) || (data.empresa is string && data.empresa.size() <= 100))
        && (!('descricao' in data) || (data.descricao is string && data.descricao.size() <= 500))
        && (!('telefone' in data) || (data.telefone is string && data.telefone.size() <= 50))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('facebook' in data) || (data.facebook is string && data.facebook.size() <= 200))
        && (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 200))
        && (!('tiktok' in data) || (data.tiktok is string && data.tiktok.size() <= 200))
        && (!('website' in data) || (data.website is string && data.website.size() <= 200))
        && (!('address' in data) || (data.address is string && data.address.size() <= 200))
        && (!('mapLat' in data) || (data.mapLat is number && data.mapLat >= -90 && data.mapLat <= 90))
        && (!('mapLng' in data) || (data.mapLng is number && data.mapLng >= -180 && data.mapLng <= 180))
        && (!('mapLabel' in data) || (data.mapLabel is string && data.mapLabel.size() <= 200))
        && (!('logo' in data) || (data.logo is string && data.logo.size() <= 980000))
        && (!('size' in data) || (data.size is string && data.size.size() <= 20))
        && (!('w' in data) || data.w is number)
        && (!('h' in data) || data.h is number)
        && (!('ori' in data) || (data.ori is string && data.ori.size() <= 5))
        && (!('status' in data) || data.status in ['ativo', 'inativo'])
        && (!('createdAt' in data) || data.createdAt is number)
        && (!('updatedAt' in data) || data.updatedAt is number);
    }

    match /cards/{cardId} {
      // Leitura individual pública para apresentar cartões por QR Code/link.
      allow get: if isValidId(cardId);

      // Apenas o administrador verificado pode listar e gerir cartões.
      allow list: if isVerifiedAdmin();

      allow create: if isVerifiedAdmin()
        && isValidId(cardId)
        && isValidCard(request.resource.data)
        && request.resource.data.slug == cardId;

      allow update: if isVerifiedAdmin()
        && isValidId(cardId)
        && isValidCard(request.resource.data)
        && request.resource.data.slug == cardId;

      allow delete: if isVerifiedAdmin()
        && isValidId(cardId);
    }
  }
}
